# ===== Call a Burger settings — copy this file to .env and fill it in =====

# --- Twilio (console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Only needed if DEDICATED_NUMBERS=false (one shared number for everyone), in +18285551234 format.
# With dedicated numbers on (the default), the app buys each user's number itself — leave this blank.
TWILIO_FROM_NUMBER=

# --- Telegram bot (create with @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
# Optional: your own chat or group that receives EVERY user's calls (admin feed). Group IDs start with -100
ADMIN_TELEGRAM_CHAT_ID=

# --- App ---
# Public HTTPS URL where Twilio and Telegram can reach this server, no trailing slash
PUBLIC_BASE_URL=https://callaburger.example.com
PORT=3000
# Max calls per user per day
DAILY_CALL_LIMIT=20
# Say "Hello, this is an automated call from <name>." before each script
ANNOUNCE_CALLER=true
# Record calls and send the MP3 to the customer's Telegram (then delete it from Twilio).
# Recorded calls always say "This call is recorded." Only records when the customer has Telegram connected.
RECORD_CALLS=true
# The app keeps only each customer's latest conversation, and deletes it this many minutes after hang-up
KEEP_CONVERSATION_MINUTES=60
# Where accounts, balances and call history are saved. On a host, point this at a PERSISTENT volume
# (e.g. Railway volume mounted at /data → DATA_DIR=/data) or balances are lost on every redeploy.
DATA_DIR=./data

# --- Captcha on Create account / Sign in (Cloudflare Turnstile, free) ---
# Get both keys at dash.cloudflare.com → Turnstile → Add widget (add your site's domain).
# Left blank, Cloudflare's always-pass TEST keys are used — fine for testing, no real protection.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Billing (USD) ---
# Charged per started minute of a connected call. Unanswered / busy / failed calls are free.
PRICE_PER_MINUTE=1.00
# Preset top-up buttons, and the allowed range for a custom amount
TOPUP_AMOUNTS=10,25,50,100
MIN_TOPUP=10
MAX_TOPUP=1000
# Free credit for new accounts (0 = none)
SIGNUP_BONUS=0
# Admins can credit/debit any balance. List your account email(s) and/or Telegram user ID(s), comma-separated.
# (Find your Telegram ID by messaging @userinfobot.)
ADMIN_EMAILS=
ADMIN_TELEGRAM_IDS=

# --- Dedicated phone numbers (each account gets its own) ---
# true = every paying account gets its own Twilio number on its first call
# false = everyone calls from TWILIO_FROM_NUMBER
DEDICATED_NUMBERS=true
# Taken from the user's balance every 30 days (Twilio charges you about $1.15/month per local number)
NUMBER_MONTHLY_FEE=2.00
# Days after a missed renewal before the number is released
NUMBER_GRACE_DAYS=7
NUMBER_COUNTRY=US

# --- Phantom / Solana wallet (direct, no processor, no fees) ---
# Your Phantom wallet's PUBLIC address: open Phantom → tap your account name → copy the Solana address.
# NEVER put your secret recovery phrase or private key here or anywhere else.
SOLANA_RECEIVE_ADDRESS=wuCR8rgxTGxbdir67knyVBDtTuL6R2YGPqGR3nPbzBd
# Public RPC works for low volume; for reliability use a free key from a provider such as Helius or QuickNode
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Bitcoin wallet (direct, no processor) ---
# Native SegWit address (starts with bc1q). In Phantom: Receive → Bitcoin → Native Segwit → Copy Address.
BITCOIN_RECEIVE_ADDRESS=bc1qadrgzjlqq7ndykh9507v77uvldpjfamcqsje5z
# Free public block explorer used to spot payments; confirmations required before crediting
BITCOIN_API_URL=https://mempool.space/api
BITCOIN_CONFIRMATIONS=1

# --- Crypto payment processors: optional, fill in one or both ---
# NOWPayments (nowpayments.io): Bitcoin, ETH, USDT, SOL and 300+ coins
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
# Stripe stablecoin payments: USDC, settles to your Stripe balance in USD (US businesses)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Voices (Amazon Polly neural voices via Twilio) ---
VOICE_FEMALE=Polly.Joanna-Neural
VOICE_MALE=Polly.Matthew-Neural

# --- Testing only ---
VALIDATE_TWILIO_SIGNATURE=true
TELEGRAM_MOCK=false
